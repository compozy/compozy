{
    "version": 2,
    "agents": [
        {
            "name": "subagent-journey-parent",
            "provider": "acpmock",
            "permissions": "approve-all",
            "turns": [
                {
                    "name": "one-delegation",
                    "match": {
                        "turn_source": "user",
                        "user_text": "get a second opinion"
                    },
                    "steps": [
                        {
                            "kind": "native_tool_call",
                            "tool_id": "compozy__subagent_capabilities",
                            "tool_call_id": "journey-capabilities",
                            "raw_input": {}
                        },
                        {
                            "kind": "native_tool_call",
                            "tool_id": "compozy__subagent_delegate",
                            "tool_call_id": "journey-delegate",
                            "raw_input": {
                                "task": "Slow review: recommend a diff panel default.",
                                "title": "Review the diff panel default",
                                "target": {
                                    "agent": "subagent-journey-worker"
                                }
                            }
                        },
                        {
                            "kind": "assistant",
                            "text": "A subagent is reviewing it; I'll pick up its answer when it finishes."
                        }
                    ]
                },
                {
                    "name": "three-delegations",
                    "match": {
                        "turn_source": "user",
                        "user_text": "split the audit three ways"
                    },
                    "steps": [
                        {
                            "kind": "native_tool_call",
                            "tool_id": "compozy__subagent_delegate",
                            "tool_call_id": "journey-group-1",
                            "raw_input": {
                                "task": "Group ok: audit payment webhooks.",
                                "title": "Audit payment webhooks",
                                "target": {
                                    "agent": "subagent-journey-worker"
                                }
                            }
                        },
                        {
                            "kind": "native_tool_call",
                            "tool_id": "compozy__subagent_delegate",
                            "tool_call_id": "journey-group-2",
                            "raw_input": {
                                "task": "Group ok: audit refund handlers.",
                                "title": "Audit refund handlers",
                                "target": {
                                    "agent": "subagent-journey-worker"
                                }
                            }
                        },
                        {
                            "kind": "native_tool_call",
                            "tool_id": "compozy__subagent_delegate",
                            "tool_call_id": "journey-group-3",
                            "raw_input": {
                                "task": "Group fail: audit checkout retries.",
                                "title": "Audit checkout retries",
                                "target": {
                                    "agent": "subagent-journey-worker"
                                }
                            }
                        },
                        {
                            "kind": "assistant",
                            "text": "Three subagents are on it."
                        }
                    ]
                },
                {
                    "name": "two-blocking",
                    "match": {
                        "turn_source": "user",
                        "user_text": "start two long audits"
                    },
                    "steps": [
                        {
                            "kind": "native_tool_call",
                            "tool_id": "compozy__subagent_delegate",
                            "tool_call_id": "journey-block-1",
                            "raw_input": {
                                "task": "Blocking work: webhooks.",
                                "title": "Long audit of webhooks",
                                "target": {
                                    "agent": "subagent-journey-worker"
                                }
                            }
                        },
                        {
                            "kind": "native_tool_call",
                            "tool_id": "compozy__subagent_delegate",
                            "tool_call_id": "journey-block-2",
                            "raw_input": {
                                "task": "Blocking work: refunds.",
                                "title": "Long audit of refunds",
                                "target": {
                                    "agent": "subagent-journey-worker"
                                }
                            }
                        },
                        {
                            "kind": "assistant",
                            "text": "Two subagents are on it."
                        }
                    ]
                },
                {
                    "name": "wake",
                    "match": {
                        "turn_source": "synthetic"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "Subagent results received."
                        }
                    ]
                }
            ]
        },
        {
            "name": "subagent-journey-worker",
            "provider": "acpmock",
            "permissions": "approve-all",
            "turns": [
                {
                    "name": "slow-review",
                    "match": {
                        "user_text_contains": "Slow review"
                    },
                    "steps": [
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "delay",
                                "delay_ms": 15000
                            }
                        },
                        {
                            "kind": "assistant",
                            "text": "Recommendation: keep branch as the default."
                        }
                    ]
                },
                {
                    "name": "group-ok",
                    "match": {
                        "user_text_contains": "Group ok"
                    },
                    "steps": [
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "delay",
                                "delay_ms": 6000
                            }
                        },
                        {
                            "kind": "assistant",
                            "text": "Audit passed with no findings."
                        }
                    ]
                },
                {
                    "name": "group-fail",
                    "match": {
                        "user_text_contains": "Group fail"
                    },
                    "steps": [
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "delay",
                                "delay_ms": 6000
                            }
                        },
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "fail_prompt",
                                "error_message": "provider rate limited"
                            }
                        }
                    ]
                },
                {
                    "name": "blocking",
                    "match": {
                        "user_text_contains": "Blocking work"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "Auditing."
                        },
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "block_until_cancel"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "subagent-native",
            "provider": "claude",
            "permissions": "approve-all",
            "prompt": "Replay the Claude Agent subagent frames.",
            "turns": [
                {
                    "name": "native-subagent-review",
                    "match": {
                        "turn_source": "user",
                        "user_text": "review the diff with a subagent"
                    },
                    "steps": [
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "write_raw_jsonrpc",
                                "raw_jsonrpc": "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"subagent-native-session-1\",\"update\":{\"_meta\":{\"claudeCode\":{\"toolName\":\"Agent\"}},\"toolCallId\":\"toolu_agent\",\"sessionUpdate\":\"tool_call\",\"name\":\"Agent\",\"rawInput\":{\"description\":\"Review the diff (high effort)\",\"prompt\":\"Review the diff\",\"model\":\"sonnet-5.5\"},\"status\":\"pending\",\"title\":\"Review the diff (high effort)\",\"kind\":\"think\",\"content\":[{\"type\":\"content\",\"content\":{\"type\":\"text\",\"text\":\"Review the diff\"}}]}}}"
                            }
                        },
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "write_raw_jsonrpc",
                                "raw_jsonrpc": "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"subagent-native-session-1\",\"update\":{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"Inspecting the diff.\"},\"_meta\":{\"claudeCode\":{\"parentToolUseId\":\"toolu_agent\"}}}}}"
                            }
                        },
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "write_raw_jsonrpc",
                                "raw_jsonrpc": "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"subagent-native-session-1\",\"update\":{\"_meta\":{\"claudeCode\":{\"toolName\":\"Read\",\"parentToolUseId\":\"toolu_agent\"}},\"toolCallId\":\"toolu_read\",\"sessionUpdate\":\"tool_call\",\"name\":\"Read\",\"rawInput\":{\"file_path\":\"/workspace/README.md\"},\"status\":\"pending\",\"title\":\"Read /workspace/README.md\",\"kind\":\"read\",\"content\":[],\"locations\":[{\"path\":\"/workspace/README.md\",\"line\":1}]}}}"
                            }
                        },
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "write_raw_jsonrpc",
                                "raw_jsonrpc": "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"subagent-native-session-1\",\"update\":{\"_meta\":{\"claudeCode\":{\"toolName\":\"Read\",\"parentToolUseId\":\"toolu_agent\"}},\"toolCallId\":\"toolu_read\",\"sessionUpdate\":\"tool_call_update\",\"status\":\"completed\",\"rawOutput\":\"Project notes\",\"content\":[{\"type\":\"content\",\"content\":{\"type\":\"text\",\"text\":\"```\\nProject notes\\n```\"}}]}}}"
                            }
                        },
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "delay",
                                "delay_ms": 6000
                            }
                        },
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "write_raw_jsonrpc",
                                "raw_jsonrpc": "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"subagent-native-session-1\",\"update\":{\"_meta\":{\"claudeCode\":{\"toolName\":\"Agent\"}},\"toolCallId\":\"toolu_agent\",\"sessionUpdate\":\"tool_call_update\",\"status\":\"completed\",\"rawOutput\":\"No issues found.\",\"content\":[{\"type\":\"content\",\"content\":{\"type\":\"text\",\"text\":\"No issues found.\"}}]}}}"
                            }
                        },
                        {
                            "kind": "assistant",
                            "text": "The reviewer found no issues."
                        }
                    ]
                }
            ]
        }
    ]
}
