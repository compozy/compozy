{
    "version": 2,
    "agents": [
        {
            "name": "side-web-agent",
            "provider": "claude",
            "permissions": "approve-all",
            "prompt": "Answer main and side questions for side chat browser journeys.",
            "turns": [
                {
                    "name": "hello",
                    "match": {
                        "user_text_contains": "hello side"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "Hello from the main session."
                        }
                    ]
                },
                {
                    "name": "busy",
                    "match": {
                        "user_text_contains": "take a while"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "main started the work"
                        },
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "delay",
                                "delay_ms": 5000
                            }
                        },
                        {
                            "kind": "assistant",
                            "text": "main finished the work"
                        }
                    ]
                },
                {
                    "name": "held",
                    "match": {
                        "user_text_contains": "keep working until stopped"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "main started the work"
                        },
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "block_until_cancel"
                            }
                        }
                    ]
                },
                {
                    "name": "busy-side",
                    "match": {
                        "user_text_contains": "what now?"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "side: main is still working"
                        }
                    ]
                },
                {
                    "name": "repo-side",
                    "match": {
                        "user_text_contains": "what is this repo?"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "side: this repo is compozy"
                        }
                    ]
                },
                {
                    "name": "quick-side",
                    "match": {
                        "user_text_contains": "quick side question"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "side: quick answer"
                        }
                    ]
                }
            ]
        },
        {
            "name": "side-native-agent",
            "provider": "claude",
            "permissions": "approve-all",
            "prompt": "Answer main and side questions for side chat browser journeys.",
            "turns": [
                {
                    "name": "hello",
                    "match": {
                        "user_text_contains": "hello side"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "Hello from the main session."
                        }
                    ]
                },
                {
                    "name": "busy",
                    "match": {
                        "user_text_contains": "take a while"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "main started the work"
                        },
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "delay",
                                "delay_ms": 5000
                            }
                        },
                        {
                            "kind": "assistant",
                            "text": "main finished the work"
                        }
                    ]
                },
                {
                    "name": "busy-side",
                    "match": {
                        "user_text_contains": "what now?"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "side: main is still working"
                        }
                    ]
                },
                {
                    "name": "repo-side",
                    "match": {
                        "user_text_contains": "what is this repo?"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "side: this repo is compozy"
                        }
                    ]
                },
                {
                    "name": "quick-side",
                    "match": {
                        "user_text_contains": "quick side question"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "side: quick answer"
                        }
                    ]
                }
            ],
            "fork_session": true
        }
    ]
}
