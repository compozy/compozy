{
    "version": 2,
    "agents": [
        {
            "name": "subagent-cli-parent",
            "provider": "acpmock",
            "permissions": "approve-all",
            "turns": [
                {
                    "name": "cli-journey",
                    "match": {
                        "turn_source": "user",
                        "user_text": "exercise subagent CLI"
                    },
                    "steps": [
                        {
                            "kind": "native_tool_call",
                            "tool_id": "compozy__subagent_delegate",
                            "tool_call_id": "cli-running",
                            "raw_input": {
                                "task": "hold CLI work",
                                "title": "Sol: diff panel default and base diff design",
                                "target": {
                                    "agent": "subagent-cli-worker"
                                }
                            }
                        },
                        {
                            "kind": "native_tool_call",
                            "tool_id": "compozy__subagent_delegate",
                            "tool_call_id": "cli-completed",
                            "raw_input": {
                                "task": "complete CLI work",
                                "title": "Edge cases: main checkout base",
                                "target": {
                                    "agent": "subagent-cli-worker"
                                },
                                "mode": "wait"
                            }
                        },
                        {
                            "kind": "assistant",
                            "text": "One subagent is running and one is completed."
                        }
                    ]
                },
                {
                    "name": "long-result",
                    "match": {
                        "turn_source": "user",
                        "user_text": "exercise result limit"
                    },
                    "steps": [
                        {
                            "kind": "native_tool_call",
                            "tool_id": "compozy__subagent_delegate",
                            "tool_call_id": "cli-long-result",
                            "raw_input": {
                                "task": "long CLI work",
                                "title": "Long result",
                                "target": {
                                    "agent": "subagent-cli-worker"
                                },
                                "mode": "wait"
                            }
                        },
                        {
                            "kind": "assistant",
                            "text": "Long answer received."
                        }
                    ]
                },
                {
                    "name": "wake",
                    "match": {
                        "turn_source": "synthetic"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "Completion received."
                        }
                    ]
                }
            ]
        },
        {
            "name": "subagent-cli-worker",
            "provider": "acpmock",
            "permissions": "approve-all",
            "turns": [
                {
                    "name": "running",
                    "match": {
                        "user_text": "hold CLI work"
                    },
                    "steps": [
                        {
                            "kind": "thought",
                            "text": "Working until canceled."
                        },
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "block_until_cancel"
                            }
                        }
                    ]
                },
                {
                    "name": "completed",
                    "match": {
                        "user_text": "complete CLI work"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "Recommendation: default the panel to 'branch' when the session has a worktree ..."
                        }
                    ]
                },
                {
                    "name": "long-answer",
                    "match": {
                        "user_text": "long CLI work"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "Long result: 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij 界abcdefghij  END OF FULL ANSWER"
                        }
