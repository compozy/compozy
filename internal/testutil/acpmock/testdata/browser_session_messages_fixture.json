{
    "version": 2,
    "agents": [
        {
            "name": "session-message-sender",
            "provider": "acpmock",
            "permissions": "approve-all",
            "turns": [
                {
                    "name": "send-question",
                    "match": {
                        "turn_source": "user",
                        "user_text": "send the reviewer a question"
                    },
                    "steps": [
                        {
                            "kind": "native_tool_call",
                            "tool_id": "compozy__session_prompt",
                            "tool_call_id": "send-question",
                            "raw_input": {
                                "session_id": "__TARGET_SESSION_ID__",
                                "message": "Is the retry budget in billing.toml per request or per job?",
                                "message_id": "msg-retry-q",
                                "idempotency_key": "msg-retry-q-key"
                            }
                        },
                        {
                            "kind": "assistant",
                            "text": "Sent the question to the reviewer."
                        }
                    ]
                },
                {
                    "name": "queue-note",
                    "match": {
                        "turn_source": "user",
                        "user_text": "queue a note for the reviewer"
                    },
                    "steps": [
                        {
                            "kind": "native_tool_call",
                            "tool_id": "compozy__session_prompt",
                            "tool_call_id": "queue-note",
                            "raw_input": {
                                "session_id": "__TARGET_SESSION_ID__",
                                "message": "Also check the webhook retry cap.",
                                "message_id": "msg-queue-note",
                                "idempotency_key": "msg-queue-note-key",
                                "mode": "queue"
                            }
                        },
                        {
                            "kind": "assistant",
                            "text": "Queued a note for the reviewer."
                        }
                    ]
                },
                {
                    "name": "ask-and-wait",
                    "match": {
                        "turn_source": "user",
                        "user_text": "ask the reviewer and wait"
                    },
                    "steps": [
                        {
                            "kind": "native_tool_call",
                            "tool_id": "compozy__session_prompt",
                            "tool_call_id": "ask-and-wait",
                            "raw_input": {
                                "session_id": "__TARGET_SESSION_ID__",
                                "message": "Is the retry budget per request or per job? Your answer comes back to me.",
                                "message_id": "msg-ask",
                                "idempotency_key": "msg-ask-key",
                                "notify_on_complete": true
                            }
                        },
                        {
                            "kind": "assistant",
                            "text": "Asked the reviewer; I'll continue when it answers."
                        }
                    ]
                },
                {
                    "name": "reply-wake",
                    "match": {
                        "turn_source": "synthetic"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "The reviewer answered: per job."
                        }
                    ]
                }
            ]
        },
        {
            "name": "session-message-receiver",
            "provider": "acpmock",
            "permissions": "approve-all",
            "turns": [
                {
                    "name": "operator-hello",
                    "match": {
                        "turn_source": "user",
                        "user_text": "hello reviewer"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "Ready to review."
                        }
                    ]
                },
                {
                    "name": "long-review",
                    "match": {
                        "turn_source": "user",
                        "user_text": "hold on a long review"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "Reviewing the whole module."
                        },
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "block_until_cancel"
                            }
                        }
                    ]
                },
                {
                    "name": "answer-retry-budget",
                    "match": {
                        "user_text_contains": "retry budget"
                    },
                    "steps": [
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "delay",
                                "delay_ms": 4000
                            }
                        },
                        {
                            "kind": "assistant",
                            "text": "Per job. The retry budget caps attempts across a job's requests."
                        }
                    ]
                },
                {
                    "name": "answer-note",
                    "match": {
                        "user_text_contains": "webhook retry cap"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "Noted."
                        }
                    ]
                }
            ]
        }
    ]
}
