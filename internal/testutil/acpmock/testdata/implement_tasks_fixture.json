{
    "version": 2,
    "agents": [
        {
            "name": "implement_tasks_implementer",
            "provider": "acpmock",
            "model": "base-model",
            "reasoning_effort": "low",
            "permissions": "approve-all",
            "prompt": "You are the deterministic implement-tasks implementer.",
            "config_options": [
                {
                    "id": "model",
                    "name": "Model",
                    "current": "base-model",
                    "values": [
                        { "value": "base-model", "label": "Base model" },
                        { "value": "docs-model", "label": "Docs model" },
                        { "value": "opus", "label": "Opus" }
                    ]
                },
                {
                    "id": "reasoning_effort",
                    "name": "Reasoning effort",
                    "current": "low",
                    "values": [
                        { "value": "low", "label": "Low" },
                        { "value": "high", "label": "High" }
                    ]
                }
            ],
            "turns": [
                {
                    "name": "complete-delivery-task",
                    "match": { "turn_source": "user" },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "{\"status\":\"completed\",\"summary\":\"Task implementation completed.\",\"files_changed\":[]}"
                        }
                    ]
                }
            ]
        }
    ]
}
