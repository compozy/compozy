{
    "version": 2,
    "agents": [
        {
            "name": "integrated-terminal",
            "provider": "claude",
            "permissions": "approve-reads",
            "prompt": "You exercise the integrated terminal public journeys.",
            "turns": [
                {
                    "name": "hold-native-approval",
                    "match": {
                        "turn_source": "user",
                        "user_text": "hold native approval"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "chunks": ["native approval ready"]
                        },
                        {
                            "kind": "driver_control",
                            "driver_control": {
                                "action": "block_until_cancel"
                            }
                        }
                    ]
                },
                {
                    "name": "terminal-quote",
                    "match": {
                        "turn_source": "user",
                        "user_text_contains": "<terminal_context"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "chunks": ["I received the sourced terminal excerpt."]
                        }
                    ]
                }
            ]
        }
    ]
}
