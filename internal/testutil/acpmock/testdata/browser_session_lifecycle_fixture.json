            "turns": [
                {
                    "name": "binding-fact",
                    "match": {
                        "turn_source": "user",
                        "user_text": "Remember the binding fact: amber otter"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "Binding fact remembered."
                        }
                    ]
                },
                {
                    "name": "binding-replayed",
                    "match": {
                        "turn_source": "user",
                        "user_text": "Check binding continuity",
                        "raw_user_text_contains": "amber otter"
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "text": "Binding conversation continued."
                        }
                    ]
                }
            ]
        },
