                                "content_hash": {
                                    "type": "string"
                                }
                            },
                            "additionalProperties": false
                        },
                        "amended_summary": {
                            "type": "object",
                            "required": ["byte_size", "content_hash"],
                            "properties": {
                                "byte_size": {
                                    "type": "integer",
                                    "minimum": 0
                                },
                                "content_hash": {
                                    "type": "string"
                                }
                            },
                            "additionalProperties": false
                        },
                        "actor_kind": {
                            "type": "string"
                        },
                        "actor_id": {
                            "type": "string"
                        },
                        "reason": {
                            "type": "string"
                        },
                        "created_at": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "watch_events": {
                "type": "object"
            }
