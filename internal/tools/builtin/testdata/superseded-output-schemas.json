                            "type": "string",
                            "minLength": 1
                        },
                        "item_index": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "kind": {
                            "type": "string",
                            "enum": ["ask", "review"]
                        },
                        "state": {
                            "type": "string",
                            "enum": ["pending", "answered", "expired", "canceled"]
                        },
                        "prompt": {
