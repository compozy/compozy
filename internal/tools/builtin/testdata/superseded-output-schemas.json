                        "answered_at": {
                            "type": "string",
                            "format": "date-time"
                        },
                        "resolved_at": {
                            "type": "string",
                            "format": "date-time"
                        },
                        "expires_at": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    "additionalProperties": false
                }
