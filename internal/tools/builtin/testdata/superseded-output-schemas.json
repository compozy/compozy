    "compozy__tool_approvals_list": {
        "type": "object",
        "required": ["grants", "total"],
        "properties": {
            "grants": {
                "type": "array",
                "items": {
                    "$ref": "#/$defs/grant"
                }
            },
            "total": {
                "type": "integer",
                "minimum": 0
            }
        },
        "$defs": {
            "grant": {
                "type": "object",
                "required": [
                    "id",
                    "profile_id",
                    "workspace_id",
                    "tool_id",
                    "decision",
                    "created_at",
                    "last_used_at"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "profile_id": {
                        "type": "string"
                    },
                    "profile_name": {
                        "type": "string"
                    },
                    "profile_color": {
                        "type": "string"
                    },
                    "profile_icon": {
                        "type": "string"
                    },
                    "profile_emoji": {
                        "type": "string"
                    },
                    "profile_archived": {
                        "type": "boolean"
                    },
                    "workspace_id": {
                        "type": "string"
                    },
                    "agent_name": {
                        "type": "string"
                    },
                    "tool_id": {
                        "type": "string"
                    },
                    "input_digest": {
                        "type": "string"
                    },
                    "decision": {
                        "type": "string",
                        "enum": ["allow", "reject"]
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "last_used_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "additionalProperties": false
            }
        },
        "additionalProperties": false
    },
    "compozy__tool_approvals_set": {
        "type": "object",
        "required": ["grant"],
        "properties": {
            "grant": {
                "type": "object",
                "required": [
                    "id",
                    "profile_id",
                    "workspace_id",
                    "tool_id",
                    "decision",
                    "created_at",
                    "last_used_at"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "profile_id": {
                        "type": "string"
                    },
                    "profile_name": {
                        "type": "string"
                    },
                    "profile_color": {
                        "type": "string"
                    },
                    "profile_icon": {
                        "type": "string"
                    },
                    "profile_emoji": {
                        "type": "string"
                    },
                    "profile_archived": {
                        "type": "boolean"
                    },
                    "workspace_id": {
                        "type": "string"
                    },
                    "agent_name": {
                        "type": "string"
                    },
                    "tool_id": {
                        "type": "string"
                    },
                    "input_digest": {
                        "type": "string"
                    },
                    "decision": {
                        "type": "string",
                        "enum": ["allow", "reject"]
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "last_used_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "additionalProperties": false
            }
        },
        "additionalProperties": false
    }
}
