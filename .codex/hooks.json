{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write|apply_patch",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \".agents/skills/impeccable/scripts/hook.mjs\"",
                        "timeout": 5,
                        "statusMessage": "Checking UI changes"
                    },
                    {
                        "type": "command",
                        "command": "bash \"scripts/hooks/edit-lint.sh\"",
                        "timeout": 45,
                        "statusMessage": "edit-time fmt + fast lint"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \".agents/skills/impeccable/scripts/hook.mjs\"",
                        "timeout": 30,
                        "statusMessage": "Design deep pass"
                    }
                ]
            }
        ]
    }
}
