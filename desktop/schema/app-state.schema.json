{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://compozy.com/schema/app-state.schema.json",
    "title": "CompozyOS app state",
    "oneOf": [
        { "$ref": "#/$defs/app_record" },
        { "$ref": "#/$defs/status_report" },
        { "$ref": "#/$defs/diagnostic_report" }
    ],
    "$defs": {
        "state": {
            "enum": [
                "resolving",
                "provisioning",
                "starting",
                "attaching",
                "product",
                "updating",
                "disconnected",
                "skew",
                "error"
            ]
        },
        "error": {
            "type": "object",
            "required": ["code", "safe_message", "log_path"],
            "properties": {
                "code": {
                    "enum": [
                        "port_conflict_foreign",
                        "runtime_start_failed",
                        "provision_network",
                        "provision_disk_space",
                        "provision_permission",
                        "runtime_unhealthy",
                        "handshake_failed",
                        "load_deadline_exceeded",
                        "update_lock_held",
                        "quiesce_failed",
                        "migration_recovery_required",
                        "config_invalid",
                        "not_owned",
                        "desktop_control_failed",
                        "boot_window_failed"
                    ]
                },
                "safe_message": { "type": "string", "minLength": 1, "maxLength": 512 },
                "log_path": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
        },
        "diagnostic_error": {
            "type": "object",
            "required": ["code", "safe_message"],
            "properties": {
                "code": {
                    "enum": [
                        "port_conflict_foreign",
                        "runtime_start_failed",
                        "provision_network",
                        "provision_disk_space",
                        "provision_permission",
                        "runtime_unhealthy",
                        "handshake_failed",
                        "load_deadline_exceeded",
                        "update_lock_held",
                        "quiesce_failed",
                        "migration_recovery_required",
                        "config_invalid",
                        "not_owned",
                        "desktop_control_failed",
                        "boot_window_failed"
                    ]
                },
                "safe_message": { "type": "string", "minLength": 1, "maxLength": 512 }
            },
            "additionalProperties": false
        },
        "diagnostic_phase": {
            "enum": [
                "bootstrap",
                "resolving",
                "provisioning",
                "starting",
                "attaching",
                "product",
                "updating",
                "disconnected",
                "skew",
                "error"
            ]
        },
        "previous_crash": {
            "type": "object",
            "required": ["boot_id", "boot_phase", "started_at"],
            "properties": {
                "boot_id": { "type": "string", "minLength": 1, "maxLength": 128 },
                "boot_phase": { "$ref": "#/$defs/diagnostic_phase" },
                "started_at": { "type": "string", "format": "date-time" }
            },
            "additionalProperties": false
        },
        "diagnostic_report": {
            "type": "object",
            "required": [
                "schema_version",
                "boot_id",
                "boot_phase",
                "app_version",
                "runtime_version",
                "runtime_owned",
                "current_error",
                "previous_crash"
            ],
            "properties": {
                "schema_version": { "const": 1 },
                "boot_id": { "type": "string", "minLength": 1, "maxLength": 128 },
                "boot_phase": { "$ref": "#/$defs/diagnostic_phase" },
                "app_version": { "type": "string", "minLength": 1, "maxLength": 128 },
                "runtime_version": { "type": ["string", "null"], "maxLength": 128 },
                "runtime_owned": { "type": ["boolean", "null"] },
                "current_error": {
                    "anyOf": [{ "$ref": "#/$defs/diagnostic_error" }, { "type": "null" }]
                },
                "previous_crash": {
                    "anyOf": [{ "$ref": "#/$defs/previous_crash" }, { "type": "null" }]
                }
            },
            "additionalProperties": false
        },
        "app_record": {
            "type": "object",
            "required": ["schema_version", "pid", "started_at", "diagnostic_report", "state"],
            "properties": {
                "schema_version": { "const": 2 },
                "pid": { "type": "integer", "minimum": 1 },
                "started_at": { "type": "string", "format": "date-time" },
                "app_version": { "type": "string" },
                "channel": { "type": "string" },
                "state": { "$ref": "#/$defs/state" },
                "stage": { "enum": ["download", "verify", "install", "start", "ready"] },
                "pct": { "type": "integer", "minimum": 0, "maximum": 100 },
                "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
                "origin": { "type": "string", "format": "uri", "pattern": "^https?://" },
                "owned": { "type": "boolean" },
                "target": { "enum": ["app", "runtime"] },
                "cause": { "enum": ["runtime_down", "health_check_failed"] },
                "runtime": { "type": "string" },
                "needed": { "type": "string" },
                "newer": { "type": "boolean" },
                "diagnostic_report": { "$ref": "#/$defs/diagnostic_report" },
                "error": { "$ref": "#/$defs/error" },
                "update": { "$ref": "#/$defs/update_status" }
            },
            "allOf": [
                {
                    "if": { "properties": { "state": { "const": "error" } } },
                    "then": { "required": ["error"] }
                },
                {
                    "if": { "properties": { "state": { "const": "product" } } },
                    "then": { "required": ["origin", "owned"] }
                },
                {
                    "if": { "properties": { "state": { "const": "starting" } } },
                    "then": { "required": ["attempt"] }
                }
            ],
            "additionalProperties": false
        },
        "runtime_status": {
            "type": "object",
            "required": ["attached", "owned"],
            "properties": {
                "attached": { "type": "boolean" },
                "owned": { "type": "boolean" },
                "version": { "type": "string" }
            },
            "additionalProperties": false
        },
        "update_status": {
            "type": "object",
            "required": ["app_state", "runtime_state"],
            "properties": {
                "app_state": {
                    "enum": [
                        "idle",
                        "checking",
                        "downloading",
                        "ready",
                        "failed",
                        "staged",
                        "applying",
                        "blocked",
                        "accepted"
                    ]
                },
                "app_available": { "type": "string" },
                "runtime_state": {
                    "enum": [
                        "idle",
                        "available",
                        "applying",
                        "recovery_required",
                        "failed",
                        "managed",
                        "staged",
                        "blocked",
                        "accepted"
                    ]
                },
                "runtime_available": { "type": "string" },
                "last_checked_at": { "type": "string", "format": "date-time" },
                "last_error": { "$ref": "#/$defs/error" },
                "operation_id": { "type": "string", "minLength": 1 },
                "phase": {
                    "enum": ["download", "verify", "install", "start", "ready-check", "ready"]
                },
                "percent": { "type": "integer", "minimum": -1, "maximum": 100 }
            },
            "additionalProperties": false
        },
        "status_report": {
            "type": "object",
            "required": ["schema_version", "installed", "running", "runtime", "update"],
            "properties": {
                "schema_version": { "const": 2 },
                "installed": { "type": "boolean" },
                "app_version": { "type": "string" },
                "channel": { "type": "string" },
                "running": { "type": "boolean" },
                "pid": { "type": "integer", "minimum": 1 },
                "state": { "$ref": "#/$defs/state" },
                "error": { "$ref": "#/$defs/error" },
                "runtime": { "$ref": "#/$defs/runtime_status" },
                "update": { "$ref": "#/$defs/update_status" }
            },
            "allOf": [
                {
                    "if": {
                        "properties": { "running": { "const": true } },
                        "required": ["running"]
                    },
                    "then": { "required": ["pid", "state"] }
                },
                {
                    "if": {
                        "properties": { "state": { "const": "error" } },
                        "required": ["state"]
                    },
                    "then": { "required": ["error"] }
                }
            ],
            "additionalProperties": false
        }
    }
}
