        {
            "id": 22,
            "type": "table",
            "title": "Recent turns (click to open the trace)",
            "datasource": {
                "type": "tempo",
                "uid": "tempo"
            },
            "gridPos": {
                "x": 0,
                "y": 61,
                "w": 24,
                "h": 9
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "tempo",
                        "uid": "tempo"
                    },
                    "queryType": "traceql",
                    "query": "{resource.service.name=\"compozy-daemon\" && name=\"session.turn\"}",
                    "limit": 50,
                    "tableType": "traces"
                }
            ]
        },
        {
            "id": 23,
            "type": "logs",
            "title": "Daemon logs",
            "datasource": {
                "type": "loki",
                "uid": "loki"
