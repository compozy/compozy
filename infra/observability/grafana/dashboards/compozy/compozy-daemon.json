{
    "uid": "compozy-daemon",
    "title": "CompozyOS — daemon",
    "tags": ["compozy", "otel"],
    "timezone": "browser",
    "refresh": "30s",
    "schemaVersion": 41,
    "time": {
        "from": "now-3h",
        "to": "now"
    },
    "panels": [
        {
            "id": 17,
            "type": "row",
            "title": "Turns",
            "collapsed": false,
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 24,
                "h": 1
            },
            "panels": []
        },
        {
            "id": 1,
            "type": "stat",
            "title": "Active sessions",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 0,
                "y": 1,
                "w": 4,
                "h": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "expr": "sum(compozy_session_active)",
                    "legendFormat": "sessions",
                    "exemplar": false
                }
            ]
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Active agents",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 4,
                "y": 1,
                "w": 4,
                "h": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "expr": "sum(compozy_agent_active)",
                    "legendFormat": "agents",
                    "exemplar": false
                }
            ]
        },
        {
            "id": 3,
            "type": "stat",
            "title": "Daemon uptime",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 8,
                "y": 1,
                "w": 4,
                "h": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "expr": "max(compozy_uptime_seconds)",
                    "legendFormat": "uptime",
                    "exemplar": false
                }
            ]
        },
        {
            "id": 4,
            "type": "timeseries",
            "title": "Turns per minute by outcome",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 12,
                "y": 1,
                "w": 12,
                "h": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "expr": "sum by (compozy_outcome) (rate(compozy_session_turn_duration_seconds_count[$__rate_interval])) * 60",
                    "legendFormat": "{{compozy_outcome}}",
                    "exemplar": false
                }
            ]
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "Turn duration p50/p95 by model",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 0,
                "y": 9,
                "w": 12,
                "h": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum by (le,gen_ai_request_model) (rate(compozy_session_turn_duration_seconds_bucket[$__rate_interval])))",
                    "legendFormat": "p95 {{gen_ai_request_model}}",
                    "exemplar": true
                },
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "B",
                    "expr": "histogram_quantile(0.5, sum by (le,gen_ai_request_model) (rate(compozy_session_turn_duration_seconds_bucket[$__rate_interval])))",
                    "legendFormat": "p50 {{gen_ai_request_model}}",
                    "exemplar": true
                }
            ]
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Time to first token p95 by model",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 12,
                "y": 9,
                "w": 12,
                "h": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum by (le,gen_ai_request_model) (rate(compozy_session_ttft_seconds_bucket[$__rate_interval])))",
                    "legendFormat": "{{gen_ai_request_model}}",
                    "exemplar": true
                }
            ]
        },
        {
            "id": 18,
            "type": "row",
            "title": "Cost and tokens",
            "collapsed": false,
            "gridPos": {
                "x": 0,
                "y": 17,
                "w": 24,
                "h": 1
            },
            "panels": []
        },
        {
            "id": 7,
            "type": "timeseries",
            "title": "Tokens/min by type",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 0,
                "y": 18,
                "w": 12,
                "h": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "expr": "sum by (compozy_token_type) (rate(compozy_tokens_total[$__rate_interval])) * 60",
                    "legendFormat": "{{compozy_token_type}}",
                    "exemplar": false
                }
            ]
        },
        {
            "id": 8,
            "type": "bargauge",
            "title": "Cost in range (USD) by model",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 12,
                "y": 18,
                "w": 12,
                "h": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "currencyUSD"
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "expr": "sum by (gen_ai_request_model, compozy_cost_status) (increase(compozy_cost_total[$__range]))",
                    "legendFormat": "{{gen_ai_request_model}} ({{compozy_cost_status}})",
                    "exemplar": false
                }
            ]
        },
        {
