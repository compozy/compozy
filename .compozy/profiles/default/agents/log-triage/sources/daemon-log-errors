#!/usr/bin/env python3
"""Log Triage check-in source: new error fingerprints in the CompozyOS daemon logs.

Reads, for the window since the last committed check (the last 24h on a first
run or with no state):

- ERROR lines of the JSON daemon logs (`compozy.log` and rotated
  `compozy-*.log`), plus ERROR lines in the plain-text slog form;
- `panic:`, `fatal error:`, `error:` and ERROR lines in `daemon-stdio.log`;
- session crash bundles in `crash-bundles/`;
- WARN lines, which only count toward a spike against the previous window.

Each line becomes a fingerprint: level, `msg`, and the error class
(`error_code`, `reason_code`, or the `error` text; the HTTP route and status
when there is no error), with quoted values, IDs, paths, timestamps and
numbers stripped. Lines group by fingerprint and the source emits one item per
fingerprint, keyed `<kind>:<sha256 prefix>`, so the same fingerprint keeps the
same key across runs. The key and attributes depend only on the fingerprint;
the count, first/last seen and samples go in the summary.

An ERROR fingerprint is emitted when it is new, when it was last emitted more
than 7 days ago, or when its count tripled since then. A WARN fingerprint is
emitted only when its hourly rate is at least 3x the previous window's and it
has at least 20 lines. A clean window emits no items, so no model turn runs.

With `params.key` set, it emits only that fingerprint over the window, with
no dedup and no state: the read-only lookup a picked proposal uses.

Sample lines carry an allowlist of log fields, never prompt or output bodies,
with the home directory replaced by `~` and secret-looking values redacted.
Read-only: it reads the log directory and never writes.
Contract: CompozyOS check-in source v1 (JSON on stdin, {"items": [...]} on stdout).
"""

import datetime as dt
import functools
import glob
import hashlib
import json
import os
import re
import sys

DEFAULT_WINDOW_HOURS = 24
RECHECK_DAYS = 7
GROWTH_FACTOR = 3
WARN_SPIKE_RATIO = 3
WARN_SPIKE_MIN = 20
WARN_BASELINE_LIMIT = 80
STATE_BUDGET = 12 << 10
SAMPLES = 2
SAMPLE_CHARS = 300
PRIORITY = {"panic": 0, "crash": 1, "error": 2, "warn": 3}
SAMPLE_FIELDS = (
    "msg", "error", "error_code", "reason", "reason_code", "status", "method", "path",
    "provider", "agent", "agent_name", "kind", "stage", "component", "event", "outcome", "phase",
)

TEXT_LINE = re.compile(r"^(\d{4}/\d\d/\d\d \d\d:\d\d:\d\d) (ERROR|WARN) (.*)$")
TEXT_ATTR = re.compile(r"\s[A-Za-z_][A-Za-z0-9_.]*=")
STDIO_ALERT = re.compile(r"^(panic: |fatal error: |error: )(.*)$")
GO_FRAME = re.compile(r"^(github\.com/compozy/compozy/\S+)\([^()]*\)\s*$")

SECRET = re.compile(
    r"(?i)\b(token|password|passwd|api[_-]?key|secret|authorization|bearer|cookie)"
    r"(\s*[:=]\s*|\s+)(\"[^\"]*\"|'[^']*'|[^\s,;\"']+)"
)
SECRET_VALUE = re.compile(
    r"\b(sk-[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}"
    r"|xox[abposr]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9._-]+)"
)
USER_HOME = re.compile(r"/(Users|home)/[^/\s\"']+")

NORMALIZERS = (
    (re.compile(r"\s*stderr=.*$", re.S), ""),
    (re.compile(r"\"(?:[^\"\\]|\\.)*\""), "\"*\""),
    (re.compile(r"'[^'\s]*'"), "'*'"),
    (re.compile(r"\d{4}-\d\d-\d\d[T ][\d:.]+(?:Z|[+-]\d\d:?\d\d)?"), "<ts>"),
    (re.compile(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"), "<uuid>"),
    (re.compile(r"(?:~|\.{0,2})/[^\s\"':,;()]+"), "<path>"),
    (re.compile(r"\b[a-z][a-z0-9_]*[-_.][0-9a-f]{8,}[0-9a-z._:-]*"), "<id>"),
    (re.compile(r"\b[0-9a-f]{12,}\b"), "<hex>"),
    (re.compile(r"\d+"), "#"),
    (re.compile(r"\s+"), " "),
)


def parse_time(value):
    """Parse RFC 3339 with up to nanosecond precision; returns aware UTC or None."""
    if not value:
        return None
    text = str(value).strip().replace("Z", "+00:00")
    match = re.match(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(\.\d+)?(.*)$", text)
    if not match:
        return None
    frac = (match.group(2) or "")[:7]
    try:
        parsed = dt.datetime.fromisoformat(match.group(1) + frac + match.group(3))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.astimezone()
    return parsed.astimezone(dt.timezone.utc)


def iso(moment):
    return moment.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def redact(text):
    text = SECRET.sub(lambda m: m.group(1) + m.group(2) + "[REDACTED]", text)
    return SECRET_VALUE.sub("[REDACTED]", text)


@functools.lru_cache(maxsize=8192)
def normalize(text, limit=160):
    text = redact(str(text or ""))
    for pattern, replacement in NORMALIZERS:
        text = pattern.sub(replacement, text)
    return text.strip()[:limit]


def sanitize(text, home):
    text = str(text or "")
    text = re.sub(r"\s*stderr=.*$", " stderr=[omitted]", text, flags=re.S)
    if home:
        text = text.replace(home, "~")
    text = redact(USER_HOME.sub("~", text))
    text = re.sub(r"\s+", " ", text).strip()
    return text[:SAMPLE_CHARS]


@functools.lru_cache(maxsize=8192)
def error_class(text, limit=160):
    """Normalized error chain; cancellations collapse to their first segment and leaf."""
    chain = normalize(text, 600)
    leaf = re.search(r"(context canceled|context deadline exceeded)$", chain)
    if leaf and ": " in chain:
        return f"{chain.split(': ')[0]}: ... {leaf.group(1)}"
    return chain[:limit]


def crash_class(failure):
    if failure.get("reason_code"):
        return normalize(str(failure["reason_code"]))
    summary = str(failure.get("summary") or "")
    for pattern in (r"provider_failure_kind=(\w+)", r'"errorKind":"(\w+)"'):
        found = re.search(pattern, summary)
        if found:
            return found.group(1)
    message = summary.startswith("{") and re.search(r'"message":"((?:[^"\\]|\\.)*)"', summary)
    if message:
        return normalize(re.split(r" · | — |\. ", message.group(1))[0], 100)
    return error_class(summary, 100)


class Groups:
    def __init__(self, start, end, home):
        self.start, self.end, self.home = start, end, home
        self.groups = {}

    def add(self, kind, level, source, msg, cls, moment, sample):
        if moment is not None and not (self.start <= moment < self.end):
            return
        # cls arrives normalized: HTTP routes keep their shape, error text does not.
        fingerprint = "|".join((level, normalize(str(msg), 120), cls))
        digest = hashlib.sha256(fingerprint.encode()).hexdigest()[:16]
        key = f"{kind}:{digest}"
        group = self.groups.get(key)
        if group is None:
            group = self.groups[key] = {
                "key": key, "kind": kind, "level": level, "source": source,
                "msg": normalize(str(msg), 120), "fingerprint": fingerprint,
                "count": 0, "first": None, "last": None, "samples": [],
            }
        group["count"] += 1
        if moment is not None:
            group["first"] = moment if group["first"] is None else min(group["first"], moment)
            group["last"] = moment if group["last"] is None else max(group["last"], moment)
        if len(group["samples"]) < SAMPLES:
            clean = sanitize(sample() if callable(sample) else sample, self.home)
            if clean and clean not in group["samples"]:
                group["samples"].append(clean)


def route(path):
    segments = str(path).split("?")[0].split("/")
    return "/".join(":id" if re.search(r"\d", seg) and not seg.startswith(":") else seg for seg in segments)


def json_class(record):
    for field in ("error_code", "reason_code"):
        if record.get(field):
            return normalize(f"{field}={record[field]}")
    if record.get("error"):
        return error_class(str(record["error"]))
    if record.get("path"):
        return f"{record.get('method', '')} {route(record['path'])} {record.get('status', '')}"[:160]
    return normalize(str(record.get("reason") or ""))


def json_sample(record):
    parts = [f"{record.get('level', '')}"]
    for field in SAMPLE_FIELDS:
        value = record.get(field)
        if value not in (None, ""):
            parts.append(f"{field}={json.dumps(value) if isinstance(value, str) else value}")
    return " ".join(parts)


@functools.lru_cache(maxsize=4096)
def local_stamp(stamp):
    try:
        return dt.datetime.strptime(stamp, "%Y/%m/%d %H:%M:%S").astimezone().astimezone(dt.timezone.utc)
    except ValueError:
        return None


def text_record(line):
    match = TEXT_LINE.match(line)
    if not match:
        return None
    stamp, level, rest = match.groups()
    moment = local_stamp(stamp)
    if moment is None:
        return None
    attr = TEXT_ATTR.search(rest)
    msg = rest[: attr.start()] if attr else rest
    err = re.search(r"\berror=(\"(?:[^\"\\]|\\.)*\"|\S+)", rest)
    cls = error_class(err.group(1).strip("\"")) if err else ""
    return moment, level, msg, cls, f"{level} {rest}"


def scan_daemon_logs(directory, groups, warns):
    paths = sorted(glob.glob(os.path.join(directory, "compozy-*.log")))
    paths.append(os.path.join(directory, "compozy.log"))
    for path in paths:
        try:
            mtime = dt.datetime.fromtimestamp(os.path.getmtime(path), dt.timezone.utc)
        except OSError:
            continue
        if mtime < groups.start:
            continue
        with open(path, encoding="utf-8", errors="replace") as handle:
            for line in handle:
                if line.startswith("{"):
                    if '"level":"ERROR"' in line:
                        level = "ERROR"
                    elif '"level":"WARN"' in line:
                        level = "WARN"
                    else:
                        continue
                    try:
                        record = json.loads(line)
                    except ValueError:
                        continue
                    moment = parse_time(record.get("time"))
                    if moment is None:
                        continue
                    msg, cls = record.get("msg") or "", json_class(record)
                    sample = functools.partial(json_sample, record)
                else:
                    parsed = text_record(line)
                    if parsed is None:
                        continue
                    moment, level, msg, cls, sample = parsed
                target = groups if level == "ERROR" else warns
                target.add("error" if level == "ERROR" else "warn", level, "daemon-log", msg, cls, moment, sample)


def scan_stdio(directory, groups, stdio_state):
    """Scan daemon-stdio.log from the committed offset; returns the next offset state."""
    path = os.path.join(directory, "daemon-stdio.log")
    try:
        info = os.stat(path)
    except OSError:
        return {}
    mtime = dt.datetime.fromtimestamp(info.st_mtime, dt.timezone.utc)
    offset = 0
    # With committed state every byte past the offset is new: the same file
    # resumes at the offset, a replaced or truncated file restarts at zero.
    resumed = bool(stdio_state)
    if stdio_state.get("ino") == info.st_ino and 0 <= stdio_state.get("off", -1) <= info.st_size:
        offset = stdio_state["off"]
    elif not resumed and mtime < groups.start:
        return {"ino": info.st_ino, "off": info.st_size}
    with open(path, "rb") as handle:
        handle.seek(offset)
        lines = handle.read().decode("utf-8", errors="replace").splitlines()
    # Without state, untimestamped lines (panics, CLI errors) inherit the
    # previous slog timestamp, or the file's creation time before the first one.
    # With state, every new byte is inside the window: times clamp into it, and
    # lines before the first timestamp carry the file's last write time.
    def clamp(moment):
        return min(max(moment, groups.start), groups.end - dt.timedelta(microseconds=1))

    born = getattr(info, "st_birthtime", None)
    if resumed:
        stamp = clamp(mtime)
    else:
        stamp = dt.datetime.fromtimestamp(born, dt.timezone.utc) if born else groups.start - dt.timedelta(seconds=1)
    for index, line in enumerate(lines):
        parsed = text_record(line)
        if parsed is not None:
            moment, level, msg, cls, sample = parsed
            stamp = clamp(moment) if resumed else moment
            if level == "ERROR":
                groups.add("error", level, "daemon-stdio", msg, cls, stamp, sample)
            continue
        alert = STDIO_ALERT.match(line)
        if not alert:
            continue
        prefix, message = alert.groups()
        kind = "error" if prefix == "error: " else "panic"
        frame = ""
        if kind == "panic":
            for follow in lines[index + 1 : index + 60]:
                found = GO_FRAME.match(follow)
                if found:
                    frame = found.group(1)
                    break
        level = "ERROR" if kind == "error" else prefix.rstrip(": ").upper()
        moment = stamp
        sample = f"{prefix}{message}" + (f" at {frame}" if frame else "")
        groups.add(kind, level, "daemon-stdio", prefix + message, frame, moment, sample)
    return {"ino": info.st_ino, "off": info.st_size}


def scan_crash_bundles(directory, groups):
    for path in glob.glob(os.path.join(directory, "crash-bundles", "*.json")):
        try:
            if dt.datetime.fromtimestamp(os.path.getmtime(path), dt.timezone.utc) < groups.start:
                continue
            with open(path, encoding="utf-8", errors="replace") as handle:
                bundle = json.load(handle)
        except (OSError, ValueError):
            continue
        failure = bundle.get("failure") or {}
        kind = failure.get("kind") or "crash"
        cls = crash_class(failure)
        sample = " ".join(
            f"{field}={json.dumps(value)}"
            for field, value in (
                ("kind", kind),
                ("reason_code", failure.get("reason_code")),
                ("provider", bundle.get("provider")),
                ("agent", bundle.get("agent_name")),
                ("state", bundle.get("state")),
                ("summary", failure.get("summary")),
            )
            if value
        )
        groups.add("crash", "CRASH", "crash-bundle", kind, cls, parse_time(bundle.get("created_at")), sample)


def should_emit(group, known, now):
    entry = known.get(group["key"])
    if not entry:
        return "new"
    try:
        emitted = dt.date.fromisoformat(entry[0])
        last_count = int(entry[1])
    except (ValueError, TypeError, IndexError):
        return "new"
    if (now.date() - emitted).days >= RECHECK_DAYS:
        return "recurring"
    if group["count"] >= max(10, GROWTH_FACTOR * last_count):
        return "growing"
    return ""


def warn_spikes(warns, baseline, hours, has_baseline):
    spikes = []
    if not has_baseline:
        return spikes
    for group in warns.groups.values():
        rate = group["count"] / hours
        previous = float(baseline.get(group["key"], 0))
        if group["count"] >= WARN_SPIKE_MIN and rate >= WARN_SPIKE_RATIO * max(previous, 0.01):
            spikes.append(group)
    return spikes


def to_item(group, reason):
    first = iso(group["first"]) if group["first"] else "unknown"
    last = iso(group["last"]) if group["last"] else "unknown"
    lines = [f"{group['count']}x {reason}, first {first}, last {last}."]
    lines += [f"sample: {sample}" for sample in group["samples"]]
    title = f"{group['level']} {group['msg'] or group['kind']}"[:200]
    return {
        "key": group["key"],
        "title": title,
        "summary": "\n".join(lines)[:1000],
        "attributes": {
            "fingerprint": group["fingerprint"][:600],
            "kind": group["kind"],
            "source": group["source"],
        },
    }


def bounded_state(state):
    known = state["known"]
    while len(json.dumps(state, separators=(",", ":"))) > STATE_BUDGET and known:
        oldest = min(known, key=lambda key: known[key][0])
        del known[oldest]
    return state


def main():
    raw = sys.stdin.read()
    request = json.loads(raw) if raw.strip() else {}
    params = request.get("params") or {}
    max_items = int((request.get("limits") or {}).get("max_items") or 20)
    previous = request.get("state") if isinstance(request.get("state"), dict) else {}

    home = os.environ.get("HOME", "")
    directory = os.path.expanduser(params.get("logs_dir") or "~/.compozy/logs")
    window_hours = float(params.get("window_hours") or DEFAULT_WINDOW_HOURS)
    now = parse_time(request.get("now")) or dt.datetime.now(dt.timezone.utc)
    start = parse_time(previous.get("cursor")) or now - dt.timedelta(hours=window_hours)
    start = max(start, now - dt.timedelta(days=RECHECK_DAYS))
    hours = max((now - start).total_seconds() / 3600, 1 / 60)

    errors = Groups(start, now, home)
    warns = Groups(start, now, home)
    scan_daemon_logs(directory, errors, warns)
    stdio = scan_stdio(directory, errors, previous.get("stdio") or {})
    scan_crash_bundles(directory, errors)

    lookup = params.get("key")
    if lookup:
        # Manual lookup of one fingerprint (the picked-proposal step): no dedup, no state.
        found = errors.groups.get(lookup) or warns.groups.get(lookup)
        items = [to_item(found, "in window")] if found else []
        json.dump({"items": items}, sys.stdout, separators=(",", ":"))
        sys.stdout.write("\n")
        return

    known = dict(previous.get("known") or {})
    candidates = []
    for group in list(errors.groups.values()) + warn_spikes(
        warns, previous.get("warn") or {}, hours, "warn" in previous
    ):
        reason = should_emit(group, known, now)
        if group["kind"] == "warn" and reason == "new":
            reason = "spike"
        if reason:
            candidates.append((group, reason))
    candidates.sort(key=lambda pair: (PRIORITY[pair[0]["kind"]], -pair[0]["count"], pair[0]["key"]))

    emitted = candidates[:max_items]
    more = len(candidates) > max_items
    for group, _ in emitted:
        known[group["key"]] = [now.date().isoformat(), group["count"]]

    if more:
        # Never advance past unreturned items: keep the window, record only
        # what was emitted, and let the next page pick up the rest.
        state = dict(previous)
        state["known"] = known
        state.setdefault("cursor", iso(start))
    else:
        top = sorted(warns.groups.values(), key=lambda group: -group["count"])[:WARN_BASELINE_LIMIT]
        state = {
            "v": 1,
            "cursor": iso(now),
            "stdio": stdio,
            "known": known,
            "warn": {group["key"]: round(group["count"] / hours, 2) for group in top},
        }

    result = {"items": [to_item(group, reason) for group, reason in emitted], "state": bounded_state(state)}
    if more:
        result["more"] = True
    json.dump(result, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:  # report a real failure to the daemon
        print(f"daemon-log-errors: {exc}", file=sys.stderr)
        sys.exit(1)
