{
    "name": "compozy-web",
    "private": true,
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "scripts": {
        "codegen": "bun run --cwd .. codegen",
        "codegen-check": "bun run --cwd .. codegen-check",
        "dev": "bun run --cwd .. codegen-dev && bun run dev:raw",
        "dev:raw": "vite --port 3000",
        "build": "bun run build:raw",
        "build:raw": "vite build",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "preview": "vite preview",
        "test": "bun run test:raw",
        "test:raw": "vitest run",
        "test:e2e": "bun run test:e2e:daemon-served",
        "test:e2e:raw": "bun run test:e2e:daemon-served:raw",
        "test:e2e:daemon-served": "bun run codegen-check && bun run test:e2e:daemon-served:raw",
        "test:e2e:daemon-served:raw": "playwright test --grep-invert @nightly",
        "test:e2e:nightly": "bun run codegen-check && bun run test:e2e:nightly:raw",
        "test:e2e:nightly:check": "bun run e2e/scripts/check-nightly-coverage.ts",
        "test:e2e:nightly:raw": "bun run test:e2e:nightly:check && playwright test --grep @nightly",
        "test:e2e:install": "playwright install chromium",
        "lint": "bun run format:check && bunx oxlint --deny-warnings",
        "format": "bunx oxfmt",
        "format:check": "bunx oxfmt --check",
        "typecheck": "bun run typecheck:raw",
        "typecheck:raw": "node ../node_modules/@typescript/native/bin/tsc --noEmit"
    },
    "dependencies": {
        "@assistant-ui/react": "0.15.23",
        "@assistant-ui/react-ai-sdk": "1.4.14",
        "@assistant-ui/react-lexical": "0.2.15",
        "@base-ui/react": "1.8.0",
        "@compozy/ui": "workspace:*",
        "@dagrejs/dagre": "^3.1.1",
        "@fontsource-variable/geist-mono": "5.3.0",
        "@fontsource-variable/inter": "5.3.0",
        "@lexical/react": "0.52.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "5.104.1",
        "@tanstack/react-router": "1.170.41",
        "@tanstack/react-virtual": "3.14.13",
        "@xstate/store": "4.2.3",
        "@xstate/store-react": "^2.0.0",
        "@xyflow/react": "12.12.0",
        "ai": "7.0.128",
        "boring-avatars": "2.0.4",
        "date-fns": "^4.4.0",
        "lexical": "0.52.0",
        "lucide-react": "1.52.0",
        "motion": "14.0.0",
        "openapi-fetch": "^0.17.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-rnd": "^10.5.3",
        "sonner": "^2.0.8",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@modelcontextprotocol/sdk": "1.32.1",
        "@playwright/test": "1.63.0",
        "@rolldown/plugin-babel": "0.2.4",
        "@storybook/addon-a11y": "10.6.1",
        "@storybook/addon-docs": "10.6.1",
        "@storybook/addon-themes": "10.6.1",
        "@storybook/react-vite": "10.6.1",
        "@tanstack/devtools-vite": "^0.8.5",
        "@tanstack/router-plugin": "1.168.42",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "fake-indexeddb": "^6.2.5",
        "jsdom": "30.1.2",
        "lucide-static": "1.52.0",
        "msw": "3.0.2",
        "msw-storybook-addon": "3.0.3",
        "openapi-msw": "2.1.0",
        "storybook": "10.6.1",
        "vite": "8.3.2",
        "vitest": "5.0.3"
    }
}
