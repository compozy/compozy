              "tool_kind": "execute",
              "raw_input": {
                "command": "git push origin main"
              }
            },
            {
              "kind": "assistant",
              "text": "Done after approval."
            }
          ]
        },
        {
          "name": "edit",
          "match": {
            "user_text_contains": "[edit]"
          },
          "steps": [
            {
              "kind": "permission",
              "tool_call_id": "edit-1",
              "title": "Edit README.md",
              "tool_kind": "edit",
              "path": "README.md",
              "raw_input": {
                "path": "README.md"
              }
            },
            {
              "kind": "assistant",
              "text": "Edited."
            }
          ]
        },
        {
          "name": "usage",
          "match": {
