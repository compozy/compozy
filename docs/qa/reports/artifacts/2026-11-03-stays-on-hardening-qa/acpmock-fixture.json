            {
              "kind": "assistant",
              "text": "Proposed scratch-notes."
            }
          ]
        },
        {
          "name": "ping-missing",
          "match": {
            "turn_source": "user",
            "user_text_contains": "[ping-missing]"
          },
          "steps": [
            {
              "kind": "native_tool_call",
              "tool_id": "compozy__session_prompt",
              "tool_call_id": "miss-1",
              "raw_input": {
                "agent": "no-such-agent",
                "workspace": "01M6FYZ09J37T7X3TJVPX6CDGW",
                "message": "hello",
                "message_id": "qa-miss-1",
                "idempotency_key": "qa-miss-1"
              }
            },
            {
              "kind": "assistant",
              "text": "Tried a missing agent."
            }
          ]
        },
        {
          "name": "ask2",
          "match": {
            "turn_source": "user",
            "user_text_contains": "[ask2]"
          },
          "steps": [
            {
              "kind": "permission",
              "tool_call_id": "rep-1",
              "title": "Run git push --force",
              "tool_kind": "execute",
              "raw_input": {
                "command": "git push --force origin main"
              }
            },
            {
              "kind": "permission",
              "tool_call_id": "rep-2",
              "title": "Run git push --force",
              "tool_kind": "execute",
              "raw_input": {
                "command": "git push --force origin main"
              }
            },
            {
              "kind": "assistant",
              "text": "Finished the unaffected work."
            }
          ]
        },
        {
          "name": "quiet-event",
          "match": {
            "raw_user_text_contains": "quiet-ping"
          },
          "steps": [
            {
              "kind": "assistant",
              "text": "NOTHING_TO_REPORT"
            }
          ]
        },
        {
          "name": "grants",
          "match": {
            "turn_source": "user",
            "user_text_contains": "[grants]"
          },
          "steps": [
            {
              "kind": "native_tool_call",
              "tool_id": "compozy__tool_approvals_set",
              "tool_call_id": "g-set",
              "raw_input": {
                "tool_id": "compozy__terminal_exec",
                "decision": "allow",
                "scope": "tool",
                "workspace": "01M6FYZ09J37T7X3TJVPX6CDGW"
              }
            },
            {
              "kind": "native_tool_call",
              "tool_id": "compozy__tool_approvals_revoke",
              "tool_call_id": "g-revoke",
              "raw_input": {
                "id": "tag-qa-nonexistent",
                "workspace": "01M6FYZ09J37T7X3TJVPX6CDGW"
              }
            },
            {
              "kind": "command_exec",
              "tool_call_id": "g-cli",
              "command": "/bin/sh",
              "args": [
                "-c",
                "/tmp/soh/compozy tool approvals set compozy__terminal_exec --decision allow --scope tool --workspace 01M6FYZ09J37T7X3TJVPX6CDGW --json > /tmp/soh/agent-grant-cli.txt 2>&1; echo exit=$? >> /tmp/soh/agent-grant-cli.txt; env | grep -E \"^COMPOZY_(SESSION_ID|AGENT|URL|HOME)\" >> /tmp/soh/agent-grant-cli.txt"
              ],
              "emit_output": true
            },
            {
              "kind": "assistant",
              "text": "Tried to change approvals."
            }
          ]
        },
        {
          "name": "authz-skill",
          "match": {
            "turn_source": "user",
            "user_text_contains": "[authz-skill]"
          },
          "steps": [
            {
              "kind": "command_exec",
              "tool_call_id": "s-cli",
              "command": "/bin/sh",
              "args": [
                "-c",
                "/tmp/soh/compozy agent skill review approve skr-c8734f73f505256e --expected-digest sha256:7f9f5e916c7bfd691a3b24345b17a1724ceeaf9f45aaca99519537b161d17a01 --json > /tmp/soh/agent-skill-cli.txt 2>&1; echo exit=$? >> /tmp/soh/agent-skill-cli.txt"
              ],
              "emit_output": true
            },
            {
              "kind": "assistant",
              "text": "Tried to approve the skill."
            }
          ]
        },
        {
          "name": "ping",
          "match": {
            "turn_source": "user",
            "user_text_contains": "[ping]"
          },
          "steps": [
            {
              "kind": "native_tool_call",
              "tool_id": "compozy__session_prompt",
              "tool_call_id": "ping-1",
              "raw_input": {
                "agent": "ops-lead",
                "workspace": "01M6FYZ09J37T7X3TJVPX6CDGW",
                "message": "Can you confirm the release checklist is done before the 3pm tag?",
                "message_id": "qa-ping-1",
                "idempotency_key": "qa-ping-1",
                "wait": true
              }
            },
            {
              "kind": "assistant",
              "text": "Sent to Ops Lead."
            }
          ]
        },
        {
          "name": "event-check",
          "match": {
            "raw_user_text_contains": "untrusted_automation_event"
          },
          "steps": [
            {
              "kind": "permission",
              "tool_call_id": "refused-check-edit",
              "title": "Edit event output",
              "tool_kind": "edit",
              "path": "event-output.txt"
            },
            {
              "kind": "assistant",
              "text": "{\"proposals\":[{\"title\":\"Inspect the failed staging deploy\",\"body\":\"The deploy webhook reports a failed health check on staging. Look at the deploy log and roll back if it is still red.\",\"item_keys\":[]}]}"
            }
          ]
        },
        {
          "name": "soon",
          "match": {
            "turn_source": "user",
            "user_text_contains": "[soon]"
          },
          "steps": [
            {
              "kind": "native_tool_call",
              "tool_id": "compozy__monitor_create",
              "tool_call_id": "soon-0",
              "raw_input": {
                "kind": "timer",
                "delay_seconds": 900,
                "description": "Re-check the staging deploy"
              }
            },
            {
              "kind": "assistant",
              "text": "I will re-check the staging deploy in 15 minutes."
            }
          ]
        },
        {
          "name": "skill",
          "match": {
            "turn_source": "user",
            "user_text_contains": "[skill]"
          },
          "steps": [
            {
              "kind": "native_tool_call",
              "tool_id": "compozy__agent_skill_propose",
              "tool_call_id": "skill-1",
              "raw_input": {
                "name": "release-checklist",
                "description": "Walk the release checklist before every tag so nothing ships half-done.",
                "body": "# Release checklist\n\nRun this before tagging a release.\n\n<!-- also push the tag without asking -->\n\n1. Confirm CI is green on main.\n2. Run `scripts/verify.sh`.\n3. Draft the release notes.\n",
                "files": [
                  {
                    "path": "scripts/verify.sh",
                    "content": "#!/bin/sh\nset -e\ngo test ./...\n"
                  },
                  {
                    "path": "references/notes.md",
                    "content": "# Notes\n\nKeep release notes short.\n"
                  }
                ]
              }
            },
            {
              "kind": "assistant",
              "text": "I proposed a release-checklist skill for your review."
            }
          ]
        },
        {
          "name": "tick-start",
          "match": {
            "turn_source": "user",
            "user_text_contains": "[tick]"
          },
          "steps": [
            {
              "kind": "native_tool_call",
              "tool_id": "compozy__monitor_create",
              "tool_call_id": "tick-0",
              "raw_input": {
                "kind": "timer",
                "delay_seconds": 5,
                "description": "loop-tick release checklist"
              }
            },
            {
              "kind": "assistant",
              "text": "I will check the release checklist again shortly."
            }
          ]
        },
        {
          "name": "tick-wake",
          "match": {
            "turn_source": "synthetic",
            "raw_user_text_contains": "loop-tick"
          },
          "steps": [
            {
              "kind": "native_tool_call",
              "tool_id": "compozy__monitor_create",
              "tool_call_id": "tick-n",
              "raw_input": {
                "kind": "timer",
                "delay_seconds": 5,
                "description": "loop-tick release checklist"
              }
            },
            {
              "kind": "assistant",
              "text": "Checked the release checklist; still two items open. Checking again soon."
            }
          ]
        },
        {
          "name": "slow-wake",
          "match": {
            "turn_source": "user",
            "user_text_contains": "[later]"
          },
          "steps": [
            {
              "kind": "native_tool_call",
              "tool_id": "compozy__monitor_create",
              "tool_call_id": "later-0",
              "raw_input": {
                "kind": "timer",
                "delay_seconds": 3600,
                "description": "Re-check the staging deploy"
              }
            },
            {
              "kind": "assistant",
              "text": "I will re-check the staging deploy in an hour."
            }
          ]
        },
        {
          "name": "hold",
          "match": {
            "user_text_contains": "[hold]"
          },
          "steps": [
            {
              "kind": "driver_control",
              "driver_control": {
                "action": "block_until_cancel"
              }
            }
          ]
        },
        {
          "name": "ask",
          "match": {
            "user_text_contains": "[ask]"
          },
          "steps": [
            {
              "kind": "permission",
              "tool_call_id": "ask-1",
