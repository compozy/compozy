{
    "name": "@compozy/site",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "generate:openapi": "bun run scripts/generate-openapi.ts",
        "generate:install": "bun run scripts/generate-install-template.ts",
        "source:generate": "bun --bun fumadocs-mdx source.config.ts .source",
        "content:generate": "bun --bun velite build",
        "generate:content": "bun run source:generate && bun run content:generate",
        "generate": "bun run generate:openapi && bun run generate:install && bun run generate:content",
        "predev": "bun run generate",
        "prebuild": "bun run generate",
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "bunx oxfmt --check && bunx oxlint --deny-warnings",
        "test": "vitest run",
        "typecheck": "node ../../node_modules/@typescript/native/bin/tsc --noEmit"
    },
    "dependencies": {
        "@compozy/ui": "workspace:*",
        "@mdx-js/mdx": "^3.1.1",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "boring-avatars": "2.0.4",
        "fumadocs-core": "16.16.2",
        "fumadocs-mdx": "15.4.6",
        "fumadocs-openapi": "12.3.0",
        "fumadocs-ui": "16.16.2",
        "lucide-react": "1.52.0",
        "mermaid": "12.1.0",
        "next": "16.3.8",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-markdown": "^10.1.0",
        "rehype-pretty-code": "^0.14.5",
        "remark": "^15.0.1",
        "remark-gfm": "^4.0.1",
        "remark-mdx": "^3.1.1",
        "shiki": "4.5.0",
        "smol-toml": "1.9.0",
        "velite": "^0.4.0",
        "yaml": "2.9.1",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "16.3.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "jsdom": "30.1.2",
        "tailwindcss": "^4.3.3",
        "vitest": "5.0.3"
    }
}
