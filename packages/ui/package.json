{
    "name": "@compozy/ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./tokens.css": "./src/tokens.css",
        "./utils": "./src/lib/utils.ts",
        "./components/*": "./src/components/*.tsx",
        "./lib/*": "./src/lib/*.ts",
        "./hooks/*": "./src/hooks/*.ts",
        "./logos": "./src/logos/index.ts"
    },
    "scripts": {
        "build": "tsc --noEmit",
        "lint": "bunx oxfmt --check && bunx oxlint --deny-warnings",
        "typecheck": "node ../../node_modules/@typescript/native/bin/tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "storybook": "storybook dev -p 6007",
        "build-storybook": "storybook build"
    },
    "dependencies": {
        "@base-ui/react": "1.8.0",
        "@base-ui/utils": "0.4.0",
        "@fontsource-variable/geist-mono": "5.3.0",
        "@headless-tree/core": "1.7.0",
        "@shadcn/react": "0.3.1",
        "@shikijs/langs": "4.5.0",
        "@shikijs/themes": "4.5.0",
        "@xterm/addon-fit": "0.11.0",
        "@xterm/addon-webgl": "0.19.0",
        "@xterm/xterm": "6.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "frimousse": "0.4.0",
        "lucide-react": "1.52.0",
        "react-colorful": "5.8.1",
        "react-resizable-panels": "4.14.2",
        "recharts": "^3.10.1",
        "shiki": "4.5.0",
        "sonner": "^2.0.8",
        "streamdown": "2.7.0",
        "tailwind-merge": "3.7.0",
        "tw-animate-css": "^1.4.0",
        "uqr": "^0.1.3"
    },
    "devDependencies": {
        "@fontsource-variable/inter": "5.3.0",
        "@headless-tree/react": "1.7.0",
        "@storybook/addon-a11y": "10.6.1",
        "@storybook/addon-docs": "10.6.1",
        "@storybook/addon-themes": "10.6.1",
        "@storybook/react-vite": "10.6.1",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "emojibase": "17.0.0",
        "emojibase-data": "17.0.0",
        "jsdom": "30.1.2",
        "lucide-static": "1.52.0",
        "storybook": "10.6.1",
        "vite": "8.3.2",
        "vitest": "5.0.3"
    },
    "peerDependencies": {
        "motion": "14.0.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "tailwindcss": "^4.3.3"
    }
}
