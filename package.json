{
    "version": "0.0.9",
    "private": true,
    "workspaces": [
        "packages/ui",
        "packages/site",
        "web",
        "sdk/typescript",
        "sdk/create-extension",
        "sdk/examples/prompt-enhancer"
    ],
    "scripts": {
        "build": "turbo run build",
        "codegen": "make codegen",
        "codegen-check": "bash scripts/codegen-check.sh",
        "dev": "turbo run dev --filter=./web",
        "doctor": "npx react-doctor@latest",
        "format": "oxfmt",
        "format:check": "bunx oxfmt --check",
        "lint": "bun run format:check && bunx oxlint --deny-warnings",
        "msw:update": "bun --cwd web msw init public --no-save && bunx oxfmt web/public/mockServiceWorker.js",
        "postinstall": "bash scripts/postinstall.sh",
        "prepare": "husky",
        "prs:scrape": "bun run scripts/scrape-prs.ts",
        "release:site-changelog": "bun run packages/site/scripts/generate-changelog-release.ts",
        "test": "turbo run test",
        "test:cold": "turbo run test --force",
        "test:e2e": "make test-e2e",
        "test:e2e:nightly": "make test-e2e-nightly",
        "test:e2e:runtime": "make test-e2e-runtime",
        "test:e2e:web": "make test-e2e-web",
        "typecheck": "turbo run typecheck"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@octokit/rest": "^22.0.1",
        "@types/node": "^26.1.1",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitest/coverage-v8": "^4.1.10",
        "husky": "^9.1.7",
        "lint-staged": "^17.2.0",
        "openapi-typescript": "^7.13.0",
        "oxfmt": "^0.60.0",
        "oxlint": "^1.75.0",
        "oxlint-plugin-react-doctor": "^0.9.1",
        "react-doctor": "^0.9.1",
        "shadcn": "^4.14.1",
        "tailwindcss": "^4.3.3",
        "turbo": "^2.10.6",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    },
    "lint-staged": {
        "*.go": "sh -c 'make fmt'",
        "*.{css,html,json,jsonc,yaml,yml,md}": [
            "oxfmt --no-error-on-unmatched-pattern"
        ],
        "*.{js,jsx,ts,tsx}": [
            "oxfmt --no-error-on-unmatched-pattern",
            "oxlint --deny-warnings"
        ]
    },
    "packageManager": "bun@1.3.4"
}
