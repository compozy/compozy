{
    "name": "compozy",
    "version": "0.3.0",
    "private": true,
    "workspaces": [
        "packages/ui",
        "packages/site",
        "web",
        "desktop",
        "sdk/typescript",
        "sdk/react",
        "sdk/examples/prompt-enhancer",
        "internal/extension/testdata/view-program-ts"
    ],
    "scripts": {
        "build": "turbo run build",
        "codegen": "make codegen",
        "codegen-check": "bash scripts/codegen-check.sh",
        "dev": "turbo run dev --filter=./web",
        "doctor": "react-doctor",
        "format": "oxfmt",
        "format:check": "bunx oxfmt --check",
        "lint": "bun run format:check && bunx oxlint --deny-warnings",
        "msw:update": "bun --cwd web msw init public --no-save && bunx oxfmt web/public/mockServiceWorker.js",
        "postinstall": "bash scripts/postinstall.sh",
        "prepare": "husky",
        "prs:scrape": "bun run scripts/scrape-prs.ts",
        "test": "turbo run test",
        "test:cold": "turbo run test --force",
        "test:e2e": "make test-e2e",
        "test:e2e:desktop": "make test-e2e-desktop",
        "test:e2e:nightly": "make test-e2e-nightly",
        "test:e2e:runtime": "make test-e2e-runtime",
        "test:e2e:web": "make test-e2e-web",
        "typecheck": "turbo run typecheck"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@octokit/rest": "^22.0.1",
        "@types/node": "^26.3.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitest/coverage-v8": "^4.1.11",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "openapi-typescript": "^7.13.0",
        "oxfmt": "^0.61.0",
        "oxlint": "^1.80.0",
        "oxlint-plugin-react-doctor": "0.9.13",
        "react-doctor": "0.9.13",
        "shadcn": "^4.19.0",
        "tailwindcss": "^4.3.3",
        "turbo": "^2.10.12",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "overrides": {
        "@assistant-ui/core": "0.3.2",
        "@assistant-ui/store": "0.3.2",
        "@assistant-ui/tap": "0.9.7",
        "assistant-stream": "0.3.31"
    },
    "lint-staged": {
        "*.go": "sh -c 'make fmt'",
        "*.{css,html,json,jsonc,yaml,yml,md}": [
            "oxfmt --no-error-on-unmatched-pattern"
        ],
        "*.{js,jsx,ts,tsx}": [
            "oxfmt --no-error-on-unmatched-pattern",
            "oxlint --deny-warnings"
        ]
    },
    "packageManager": "bun@1.4.0",
    "patchedDependencies": {
        "@assistant-ui/store@0.3.2": "patches/@assistant-ui%2Fstore@0.3.2.patch",
        "@assistant-ui/tap@0.9.7": "patches/@assistant-ui%2Ftap@0.9.7.patch"
    }
}
