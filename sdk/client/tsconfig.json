{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "rootDir": ".",
        "outDir": "./dist",
        "types": ["node"],
        "noEmit": true,
        "paths": {
            "@compozy/client": ["./src/index-node.ts"],
            "@compozy/client/node": ["./src/node.ts"]
        }
    },
    "include": ["src/**/*.ts", "e2e/**/*.ts"],
    "exclude": ["dist/**", "**/node_modules/**"]
}
