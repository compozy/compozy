{
    "name": "@compozy/extension-sdk",
    "version": "0.1.0",
    "private": false,
    "description": "TypeScript SDK for building CompozyOS subprocess extensions",
    "homepage": "https://compozy.com",
    "bugs": "https://github.com/compozy/compozy/issues",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/compozy/compozy.git",
        "directory": "sdk/typescript"
    },
    "files": [
        "dist/**/*"
    ],
    "sideEffects": false,
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "require": "./dist/cjs/index.js",
            "import": "./dist/esm/index.js"
        },
        "./testing": {
            "types": "./dist/types/testing/index.d.ts",
            "require": "./dist/cjs/testing/index.js",
            "import": "./dist/esm/testing/index.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true,
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "codegen-check": "bun run --cwd ../.. codegen-check",
        "build": "rm -rf dist && tsc -p tsconfig.types.json && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node ./scripts/postbuild.mjs",
        "typecheck": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
        "test": "vitest run --config vitest.config.ts",
        "coverage": "vitest run --config vitest.config.ts --coverage"
    },
    "engines": {
        "node": ">=18"
    }
}
