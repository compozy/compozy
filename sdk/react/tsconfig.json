{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "rootDir": "./src",
        "outDir": "./dist",
        "types": ["node", "react"],
        "exactOptionalPropertyTypes": true,
        "noEmit": true
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["dist/**", "**/node_modules/**"]
}
