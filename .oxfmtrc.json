{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "singleQuote": false,
    "semi": true,
    "useTabs": false,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "editorconfig": true,
    "ignorePatterns": [
        "**/node_modules/**",
        "**/dist/**",
        "**/bin/**",
        "**/.turbo/**",
        "**/.tmp/**",
        "**/coverage/**",
        "**/*.min.js",
        ".resources/**",
        ".old_project/**",
        ".claude/skills/**",
        ".agents/skills/**",
        "internal/bridges/testdata/slack-manifest-schema-v0.5.0/manifest.schema.1.0.0.json",
        "internal/tools/builtin/testdata/native-tool-catalog.json",
        "openapi/agh.json",
        "**/routeTree.gen.ts",
        ".compozy/tasks/**",
        "docs/**"
    ]
}
